-- DEBUGGING
function setup_log(level, header, enabled)
    if not dbg_pr then
        dbg_pr = ag_logging.new({
            level=level,
            header=header,
            enabled=enabled
        })
    else
        dbg_pr:SetLevel(level)
        dbg_pr:Enable(enabled)
    end
end

function dbg(level, fmt, ...)
    if not dbg_pr then
        setup_log(get_config("debug_level"), LOG_HEADER, get_config("enable_debug"))    
    end
    dbg_pr:Log(level, fmt, ...)
end

-- Main Funcs
function on_phrase_callback(sound_name, npc)
    if not ENABLE_SUBS then return end
    -- dbg("dev", "on phrase callback: name:%s, sound:%s", get_npc_name(npc), sound_name)    
    local parsed_file = parse_sound_file(sound_name)
    subtitle_them(parsed_file, npc)
end

function parse_sound_file(file)
    if 
        is_not_empty(file_cache) 
        and contains(file_cache, file, true) 
        and in_snd_dir(file_cache[file])
    then
        local cached_filename = file_cache[file]
        -- dbg("dev", "Using %s cached file for %s\n", file, cached_filename)
        if not contains(log_file_cache.cached, cached_filename) then
            log_file_cache.cached[#log_file_cache.cached + 1] = cached_filename    
        end
        return cached_filename
    end

    if in_snd_dir(file) then
        -- dbg("dev", "Path exists in sounds dir: %s\n", file and true or false)
        file_cache[file] = file
        log_file_cache.normal[#log_file_cache.normal + 1] = file
        return file

    elseif not in_snd_dir(file) then

        -- Split the end digit. Engine adds an extra digit idk why
        local end_digit = "1"
        for mtch in file:gmatch("_%d+") do
            end_digit = mtch:gsub("_", "")
        end
        local filename_prefix = file:gsub(end_digit, "")
        for i=1, end_digit:len() do
            local new_file = filename_prefix .. end_digit:sub(i, i)
            if in_snd_dir(new_file) then
                -- dbg("dev", "After Spliting: %s, found: %s\n", file, new_file)
                log_file_cache["split"][#log_file_cache["split"] + 1] = file
                file_cache[file] = new_file
                return new_file
            end
        end

        -- Try to walk back end_digit 
        local end_digits = get_end_digits(file)
        for i=1, #end_digits do
            local end_digit = end_digits[#end_digits + 1 - i]
            local end_digit_num = tonumber(end_digit)

            if end_digit_num > 0 then
                -- dbg("dev", "Walking back end digit on soundname from %s to 1\n", end_digit_num)
                for l=1, end_digit_num do
                    local prefix = file:gsub("%d+$", "")
                    local new_file = prefix .. tostring(end_digit_num + 1 - l)
                    -- dbg("dev", "Trying path: %s", new_file)
                    if in_snd_dir(new_file) then
                        -- dbg("dev", "Walked back end digit on soundname and found: %s\n", new_file)
                        file_cache[file] = new_file
                        log_file_cache.norm_walkback[#log_file_cache.norm_walkback + 1] = file
                        return new_file
                    end
                end
            end
        end
        
        -- Engine also jumbles up fight paths, feel like it's used as a queue in string form
        -- the last part that includes fight should be partnered with the inital sound prefix
        -- Example str: characters_voice\human\csky_1\fight\attack\attack_,fight\attack\attack_one_,fight\fire\fire_7
        
        local start, fin = file:find("fight")
        if start then
            -- dbg("dev", "Parsing weird fight string: %s", file)
            local prefix = file:sub(0, start - 1)
            local fight_str = file:sub(start, file:len())
            
            local end_digits = ""
            local tkns = {}
            for a, b in pairs(split(fight_str, ",")) do
                tkns[#tkns + 1] = b:gsub("%d+$", "")
            end
            
            local end_digits = get_end_digits(file)

            for i=1, #tkns do
                for j=1, #end_digits do
                    local fight_tkn = tkns[#tkns + 1 - i]
                    local end_digit = end_digits[#end_digits + 1 - j]
                    local fight_file = prefix .. fight_tkn .. end_digit

                    -- dbg("dev", "Trying path: %s", fight_file)
                    if in_snd_dir(fight_file) then
                        -- dbg("dev", "Found Weird Fight String: %s\n", fight_file)
                        log_file_cache.fight[#log_file_cache.fight + 1] = fight_file
                        file_cache[file] = fight_file
                        return fight_file
                    else
                        local end_digit_num = tonumber(end_digit)
                        if end_digit_num > 0 then
                            -- dbg("dev", "Walking back end digit from %s to 1", end_digit_num)
                            for l=1, end_digit_num do
                                fight_file = prefix .. fight_tkn .. tostring(end_digit_num + 1 - l)
                                if in_snd_dir(fight_file) then
                                    -- dbg("dev", "Walked back end digit and found: %s\n", fight_file)
                                    file_cache[file] = fight_file
                                    log_file_cache.fight_walkback[#log_file_cache.fight_walkback + 1] = file
                                    return fight_file
                                end
                            end
                        end
                    
                    end
                end
            end
        end
        -- dbg("dev", "Invalid path: %s\n", file)
        log_file_cache.invalid[#log_file_cache.invalid + 1] = file
    end
end

function subtitle_them(path, npc)
    if not path or not npc then return end
    if not db.actor then return end
    if db.actor:position():distance_to(npc:position()) > (CAPTION_HEAR_DIST * 2) then return end
    local npc_id = npc:id()
    if npc_id == AC_ID then return end
    dbg("dev", "subtitling: %s with %s", npc_id, path)
    --local name = get_npc_name(npc)
    local xml_id = path_to_xml(path)
    local xml_text = gts(xml_id)
    local tokens = xml_to_tokens(xml_text)

    local snd = sound_object(path)
    local word_count = count_words(tokens)
    local length = USE_SND_LEN and snd:length() or math.max(word_count * 100, sec_to_ms(word_count / WORDS_PER_SECOND))
    local fade_time_ms = sec_to_ms(FADE_TIME)

    local subtitle_info = {
        path = path,
        id = strformat("%s_%s", npc_id, xml_id),
        npc_id = npc_id,
        xml_id = xml_id,
        xml_text = xml_text,
        tokens = tokens,
        tokens_added = 0,

        length = length,
        sound_duration = length + time_global(),
        show_time = length + fade_time_ms + time_global(),
        caption_tmr = 0,
        fade_tmr = 0,
        check_material_tmr = 0,
        alpha_update_tmr = 0,

        caption_opacity = SUBTITLE_CLR.a,
        bg_opacity = BACKGROUND_CLR.a,
        caption_size = SUBTITLE_WND_SIZE,

        npc_pos = npc:bone_position("bip01_head"),
        npc_faction = get_npc_faction(npc) or "default",
    }
    subtitle_info.fade_tmr = subtitle_info.show_time - fade_time_ms
    subtitle_info.token_size = #subtitle_info.tokens
    -- dbg("dev", "checking if info for %s is valid: %s", npc_id, subtitle_info)
    if not validate_subtitle(subtitle_info) then
        if not contains(log_file_cache.invalid, path) then
            log_file_cache.invalid[#log_file_cache.invalid + 1] = subtitle_info.path    
        end
        return 
    end
    queue_subtitle(subtitle_info, npc)
end

function validate_subtitle(info)
    if info.xml_text == info.xml_id then
        dbg("all", "No xml text found for %s", info.xml_id)
        return false
    end

    if contains(exclude_subs, info.xml_text) then 
        dbg("all", "Invalid subtitle: %s", info.xml_id)
        return false
    end

    return true
end

function queue_subtitle(info)
    local id = info.npc_id
    if not contains(QUEUED_SUBTITLES, id, true) then
        QUEUED_SUBTITLES[id] = {}
        dbg("dev", "init subs: %s", id)
    end
    dbg("dev","queuing subs for: %s", id)
    QUEUED_SUBTITLES[id][#QUEUED_SUBTITLES[id] + 1] = info
end

function xml_to_tokens(xml_text, sep)
    -- dbg("all", "Convering xml to tokens: %s", xml_text)
    local words = get_word_tokens(xml_text, sep)
    local sub_tokens = get_sub_tokens(words)
    -- dbg("all", "tokens: %s", sub_tokens)
    return sub_tokens
end

function get_word_tokens(text, sep)
    sep = sep and sep or "%s"
    local words = {}
    local ending_mark = "[%.?!,]$"
    local line_break = "\n"
    for idx, tkn in pairs(split(text, sep)) do
        if tkn:find(ending_mark) then
            for mtch in tkn:gmatch(ending_mark) do
                local end_char = mtch .. "$"
                local rpl = mtch .. line_break
                words[#words + 1] = tkn:gsub(end_char, rpl)
            end
        else
            words[#words + 1] = tkn
        end
    end
    
    apply_censor(words)
    return words
end

function apply_censor(words)
    local terms_to_censor = censor_terms[CENSOR_TYPE]
    -- dbg("all","applying censor %s, for %s", CENSOR_TYPE, words)
    if is_not_empty(terms_to_censor) then
        for idx, wrd in pairs(words) do
            local word = lowercase(wrd)
            for _, term in pairs(terms_to_censor) do
                if word:find(term) then
                    words[idx] = string.rep(CENSOR_SYMBOL, #wrd)
                    break
                end
            end
        end
    end
end

function get_sub_tokens(words)
    local tokens = {}
    
    -- dbg("all","get sub tokens for words: %s", words)
    if #words % WORDS_PER_SECOND == 0 then
        --pr("is divisble by %s", WORDS_PER_SECOND)
        local j = 1
        for i=1, #words / WORDS_PER_SECOND do
            local tkn_str = ""
            for k=0, WORDS_PER_SECOND - 1 do
                tkn_str = string.format("%s %s", tkn_str, words[j + k])
            end
            tokens[#tokens + 1] = trim(tkn_str) --string.format("%s %s %s", words[j], words[j + 1], words[j + 2])
            j = j + WORDS_PER_SECOND
        end
        --pr("tokens: %s", print_table(tokens))
        return tokens
    else
        -- dbg("dev", "word count: %s", #words)
        local new_word_count = #words
        for i=1, new_word_count do
            new_word_count = new_word_count - 1
            if new_word_count % WORDS_PER_SECOND == 0 then
                break
            end
        end
        print(new_word_count)
        -- dbg("dev", "new word count: %s", new_word_count)
        -- dbg("dev", "getting main tokens")
        tokens = get_sub_tokens(table_slice(words, 1, new_word_count))
        -- dbg("dev", "getting the remainder")
        tokens[#tokens + 1] = table.concat(table_slice(words, new_word_count + 1, #words), " ")
        tokens[#tokens] = tokens[#tokens]:gsub("%s$", "")
        -- dbg("dev", "tokens: %s", print_table(tokens))
        return tokens
    end
    return words
end

function count_words(tkns)
    local count = 0
    for idx, tkn in pairs(tkns) do
        for _ in tkn:gmatch("%S+") do
            count = count + 1
        end
    end
    return count
end

-- NPC Deaths

function init_npc_death(id)
    if not contains(recent_npc_deaths, id, true) then
        recent_npc_deaths[id] = time_global() + 1500
    end
end

function remove_npc_death(id)
    if contains(recent_npc_deaths, id, true) then
        recent_npc_deaths[id] = nil
    end
end

function update_recent_npc_deaths()
    if is_empty(recent_npc_deaths) then return end
    local tg = time_global()
    for id, remove_time in pairs(recent_npc_deaths) do
        if tg >= remove_time then
            remove_npc_death(id)
        end
    end
end

function npc_on_death_callback(npc, killer)
    init_npc_death(npc:id())
end

function print_file_count()
    dbg("all", "Dumping log file cache")
    for typ, files in pairs(log_file_cache) do
        dbg("all", "File Validation Type: %s, Total: %s, Filenames: %s", typ, size_table(files), files)
    end
end

function on_option_change(options)
    setup_log(options["debug_level"], LOG_HEADER, options["enable_debug"])
    -- FADE_TIME           = options["fade_time"]
    CAPTION_HEAR_DIST       = options["hear_dist"]
    -- WORDS_PER_SECOND    = options["words_per_second"]
    -- MIN_CAPTION_OPACITY = options["min_caption_opacity"]
    -- MAX_CAPTION_OPACITY = options["max_caption_opacity"]
    ENABLE_SUBS         = options["enable_subs"]
    ENABLE_FIGHT_SUBS   = options["enable_fight_subs"]
    CENSOR_TYPE         = options["censor_type"]
    BACKGROUND_CLR      = str2argb(options["background_colour"], true)
    SUBTITLE_CLR        = str2argb(options["subtitle_colour"], true)
    SUBTITLE_WND_SIZE   = {w=options["subtitle_width"], h=options["subtitle_height"]}
    WORDS_PER_SECOND    = options["words_per_second"]
    FADE_TIME           = options["fade_time"]
    USE_SND_LEN         = options["use_snd_length"]
    dbg("debug", "Received options: %s", options)
end

function on_game_start()
    RegisterScriptCallback("on_phrase_callback", on_phrase_callback)
    RegisterScriptCallback("actor_on_net_destroy", print_file_count)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
    RegisterScriptCallback("actor_on_update", update_recent_npc_deaths)
    RegisterScriptCallback("as_on_option_change", on_option_change)
end

