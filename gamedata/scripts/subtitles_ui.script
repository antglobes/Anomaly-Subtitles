    -- -- dbg("dev", "steps: %s, dist: %s", step, dist)
    -- local old_pos = self.caption:GetWndPos()
    -- local smoothed_pos = vector():set(
    --     ema("caption_pos_x", new_pos.x, old_pos.x, step, math.min(50, device().time_delta)),
    --     ema("caption_pos_y", new_pos.y, old_pos.y, step, math.min(50, device().time_delta)),
