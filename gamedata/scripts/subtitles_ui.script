-- Library Imports
ag_utils.import(this, {ag_tables, ag_game_objects, ag_position, ag_maths, ag_colours, ag_npc})

-- Script Imports
geo_ray = demonized_geometry_ray.geometry_ray
mcm2font = subtitles_mcm.mcm2font
mcm2align = subtitles_mcm.mcm2align
get_config = subtitles_mcm.get_config

-- Utils
get_npc_faction = subtitles_utils.get_npc_faction
material_sound_peneration_factors = subtitles_utils.material_sound_peneration_factors
ADDITIONAL_ALPHA_TYPES = subtitles_utils.ADDITIONAL_ALPHA_TYPES

-- Constants
MIN_ALPHA = 0
MAX_ALPHA = 255
FADE_TIME = 2
LOG_HEADER = "[AS|UI]"
CROUCH_COEF = ini_sys:r_float_ex("actor", "crouch_coef") 
RUN_COEF = ini_sys:r_float_ex("actor", "run_coef")
SPRINT_COEF = ini_sys:r_float_ex("actor", "sprint_coef")

-- MCM
CAPTION_HEAR_DIST = subtitles_mcm.defaults["hear_dist"]
COLOUR_BLIND_TYPE = subtitles_mcm.defaults["colour_blind_type"]
ENABLE_FACTION_CLR = subtitles_mcm.defaults["enable_faction_clr"]
ENABLE_BACKGROUND = subtitles_mcm.defaults["enable_background"]
BACKGROUND_CLR = str2argb(subtitles_mcm.defaults["background_colour"], true)
SUBTITLE_CLR = str2argb(subtitles_mcm.defaults["subtitle_colour"], true)
SUBTITLE_FONT = mcm2font(subtitles_mcm.defaults["subtitle_font"])
SUBTITLE_ALIGNMENT = mcm2align(subtitles_mcm.defaults["subtitle_alignment"])
CAPTION_OFFSET = subtitles_mcm.defaults["caption_offset"]
SUBTITLE_WND_SIZE = {w=subtitles_mcm.defaults["subtitle_width"], h=subtitles_mcm.defaults["subtitle_height"]}
ENABLE_SUBS = subtitles_mcm.defaults["enable_subs"]
WORDS_PER_SECOND = subtitles_mcm.defaults["words_per_second"]
ENABLE_FIGHT_SUBS = subtitles_mcm.defaults["enable_fight_subs"]
REDUCE_HEAR_DIST = subtitles_mcm.defaults["reduce_hear_dist"]
OBSTRUCT_CHECK   = subtitles_mcm.defaults["obstruct_check"]
EXCLUDE_MATERIALS = subtitles_mcm.defaults["exclude_materials"]
ADD_ALPHA_TYPE = subtitles_mcm.defaults["additional_alpha_type"]

-- Globals
HUD = nil
DESPAWNED_NPCS = {}

-- Locals
local dbg_pr = nil

-- DEBUGGING
function setup_log(level, header, enabled)
    if not dbg_pr then
        dbg_pr = ag_logging.new({
            level=level,
            header=header,
            enabled=enabled
        })
    else
        dbg_pr:SetLevel(level)
        dbg_pr:Enable(enabled)
    end
end

function dbg(level, fmt, ...)
    if not dbg_pr then
        setup_log(get_config("debug_level"), LOG_HEADER, get_config("enable_debug"))    
    end
    dbg_pr:Log(level, fmt, ...)
end

class "UICaption"
function UICaption:__init(parent, npc_id)
    self.parent = parent
    self.npc_id = npc_id

    self.active_info =  {}

    self.bg = self.parent.xml:InitStatic("background", self.parent)
    self.caption = self.parent.xml:InitTextWnd("caption", self.parent)

    self.bg:Show(false)
    self.caption:Show(false)
    
    self.last_npc_pos = nil
    self.last_actor_pos = nil
    self.last_material = nil

    self.scale = 1
    self.init_fade = false
    self.options_tmr = 0
    self:ApplyScreenRatio(self.caption)
    self:ApplyScreenRatio(self.bg)
end

function UICaption:__finalize()
    self.bg:Show(false)
    self.caption:Show(false)
end

function UICaption:Update(show_caption)
    local tg = time_global()

    local pos = self:GetScreenPosition()
    if 
        show_caption 
        and self:ScreenPosValid(pos) 
        and self:Validate(self.active_info) 
    then
        self.bg:Show(true)
        self.caption:Show(true)    
        self:SetCaptionVec(pos)
        self:UpdateOptions() 
        self:UpdateCaptionAlpha() 
    else
        self.bg:Show(false)
        self.caption:Show(false)
    end

    -- dbg("dev","Show caption: %s, valid screen pos?: %s", show_caption, self:ScreenPosValid(pos))
     --and self:ScreenPosValid(pos) then
    if is_empty(self.active_info) and is_not_empty(subtitles.QUEUED_SUBTITLES[self.npc_id]) then              
        self.active_info = table.remove(subtitles.QUEUED_SUBTITLES[self.npc_id], 1)
        dbg("all","init active info with %s", self.active_info)
        self:SetCaptionClr()
        self:AddTokensToCaption(tg)

    elseif is_not_empty(self.active_info) then
        
        -- Stage 1: Add/Update Caption until Sound Duration Reached
        if tg <= self.active_info["show_time"] and tg <= self.active_info["sound_duration"] 
            and tg >= self.active_info["caption_tmr"] and is_not_empty(self.active_info["tokens"]) then
            self:AddTokensToCaption(tg)
        end

        -- Stage 2: Once Sound Duration Reached Fade Caption until Show Time Reached
        if tg < self.active_info["show_time"] and tg >= self.active_info["sound_duration"]
            and tg >= self.active_info["fade_tmr"] then
            self:FadeCaption()
        end

        -- Stage 3: Both Show Time and Sound Duration has been reached, Move to Next
        if tg >= self.active_info["show_time"] and tg >= self.active_info["sound_duration"] then
            dbg("all","hiding caption for %s at %s", self.npc_id, self.active_info["show_time"])
            self.active_info = {}
            self.bg:Show(false)
            self.caption:Show(false)
            self.caption:SetText("")
            self.bg:SetWndSize(vector2():set(self.max_bg_w, self.max_bg_h))
            self.init_fade = false
            return
        end
    end
end

function UICaption:UpdateOptions() -- UpdateBackgroundAlpha
    if not ENABLE_BACKGROUND and BACKGROUND_CLR.a == MIN_ALPHA then return end
    if time_global() < self.options_tmr then return end
    local bg_clr = self.bg:GetTextureColor()
    local bg_argb = float2argb(bg_clr, true)
    if 
        time_global() < self.active_info["sound_duration"] 
        and BACKGROUND_CLR.a ~= bg_argb.a 
    then
        self:SetCaptionClr()
    end
    self:UpdateCaptionWndSize()
    self.options_tmr = time_global() + 200
end

function UICaption:UpdateCaptionWndSize()
    if 
        self.active_info["caption_size"].w == SUBTITLE_WND_SIZE.w
        or self.active_info["caption_size"].h == SUBTITLE_WND_SIZE.h
    then
        return
    end
    local new_size = vector2():set(
        clamp(SUBTITLE_WND_SIZE.w, 1, device().width),
        clamp(SUBTITLE_WND_SIZE.h, 1, device().height)
    )
    self.caption:SetWndSize(new_size)
    self.bg:SetWndSize(new_size)
    self.active_info["caption_size"] = {w=new_size.x, h=new_size.y}
end

function UICaption:UpdateCaptionAlpha()
    if ADD_ALPHA_TYPE == ADDITIONAL_ALPHA_TYPES.none then return end
    if time_global() < self.active_info["alpha_update_tmr"] then return end
    local max_cap_alpha = ENABLE_FACTION_CLR and self.active_info["faction_clr"] and self.active_info["faction_clr"].a or SUBTITLE_CLR.a 
    local max_bg_alpha = ENABLE_BACKGROUND and BACKGROUND_CLR.a or MIN_ALPHA
    dbg("dev", "max alpha|cap:%s, bg: %s", max_cap_alpha, max_bg_alpha)
    if ADD_ALPHA_TYPE == ADDITIONAL_ALPHA_TYPES.dist_based_alpha then
        self:UpdateCaptionDistAlpha(max_cap_alpha, max_bg_alpha)
    elseif 
        OBSTRUCT_CHECK 
        and ADD_ALPHA_TYPE == ADDITIONAL_ALPHA_TYPES.snd_pen_alpha 
    then
        self:UpdateCaptionSndAlpha(max_cap_alpha, max_bg_alpha)
    end
    self.active_info["alpha_update_tmr"] = time_global() + 200
end

function UICaption:UpdateCaptionDistAlpha(max_cap_alpha, max_bg_alpha) -- mcm option dist based alpha or 
    if time_global() >= self.active_info["sound_duration"] then return end
    local npc = get_unknown_object({id=self.npc_id}, "game")
    if not npc then return end
    local dist = db.actor:position():distance_to(npc:position()) -- magnitude based on zoom factor or fov
    local norm_dist = clamp(normalize(dist, 0, CAPTION_HEAR_DIST), 0, 1)
    dbg("dev", "dist: %s, norm dist: %s", dist, norm_dist)
    local targ_cap_alpha = lerp(max_cap_alpha, MIN_ALPHA, norm_dist)
    local targ_bg_alpha = lerp(max_bg_alpha, MIN_ALPHA, norm_dist)
    dbg("dev", "updating caption dist alpha| bg: %s, cap: %s", targ_bg_alpha, targ_cap_alpha)
    self.active_info["caption_opacity"] = targ_cap_alpha
    self.active_info["bg_opacity"] = targ_bg_alpha
    self:SetCaptionClr()
end

function UICaption:UpdateCaptionSndAlpha(max_cap_alpha, max_bg_alpha)
    if time_global() >= self.active_info["sound_duration"] then return end
    local targ_cap_alpha = SUBTITLE_CLR.a
    local targ_bg_alpha = BACKGROUND_CLR.a
    if self.last_material then
        local snd_pen_fac = material_sound_peneration_factors[self.last_material] or 0
        targ_cap_alpha = round(max_cap_alpha * snd_pen_fac)
        targ_bg_alpha = round(max_bg_alpha * snd_pen_fac)
    end
    dbg("dev", "updating caption snd alpha| bg: %s, cap: %s", targ_bg_alpha, targ_cap_alpha)
    self.active_info["caption_opacity"] = targ_cap_alpha
    self.active_info["bg_opacity"] = targ_bg_alpha
    self:SetCaptionClr()
end


function UICaption:AddTokensToCaption(tg) --add get text size to engine
    if is_empty(self.active_info) then return end
    if is_empty(self.active_info["tokens"]) then return end
    local sub_tkn = table.remove(self.active_info["tokens"], 1)
    local subtitle = strformat("%s %s", self.caption:GetText(), sub_tkn)
    local sub_text_size = self.caption:GetTextSize()
    if  
        self.active_info["tokens_added"] < 1
        or round(sub_text_size.x) > SUBTITLE_WND_SIZE.w
        -- and round(sub_text_size.y) <= SUBTITLE_WND_SIZE.h
    then
        subtitle = sub_tkn
    end
    -- dbg("dev", "subtitle text size: %s", sub_text_size)
    -- dbg("dev", "mcm subtitle wnd size: %s", SUBTITLE_WND_SIZE)
    self.caption:SetText(subtitle)
    -- dbg("dev", "for %s setting subtitle to: %s", self.npc_id, subtitle)
    self.active_info["caption_tmr"] = tg + ((self.active_info["length"] / self.active_info["token_size"]))
    self.active_info["tokens_added"] = self.active_info["tokens_added"] + 1
    -- font
    self.caption:SetFont(SUBTITLE_FONT)

    -- alignment
    self.caption:SetTextAlignment(SUBTITLE_ALIGNMENT)

    --dbg("dev","Updating tokens to caption: subtitle %s, token: %s, tmr: %s", subtitle, sub_tkn, self.active_info["caption_tmr"])
    local bg_height = self.bg:GetHeight()
    local bg_size = vector2():set(self.bg:GetWidth(),(bg_height + 3))
    self.bg:SetWndSize(bg_size)
end

function UICaption:FadeCaption(tg)
    if is_empty(self.active_info) then return end
    local elapsed_time = time_global() + math.min(50, device().time_delta)
    if not self.init_fade then
        self.active_info["fade_start_time"] = time_global()
        self.active_info["fade_end_time"] = self.active_info["show_time"]
        self.init_fade = true
    end

    local time_factor = clamp(normalize(elapsed_time, self.active_info["fade_start_time"], self.active_info["fade_end_time"]), 0, 1)

    local bg_clr = self.bg:GetTextureColor()
    local bg_argb = float2argb(bg_clr, true)
    local new_bg_alpha = clamp(round(lerp(bg_argb.a, MIN_ALPHA, time_factor)), MIN_ALPHA, MAX_ALPHA)
    self.bg:SetTextureColor(change_alpha(bg_clr, new_bg_alpha))
    self.active_info["bg_opacity"] = new_bg_alpha
    -- dbg("all", "bg alpha| old: %s, new:%s", bg_argb.a, new_bg_alpha)

    local cap_clr = self.caption:GetTextColor()
    local cap_argb = float2argb(cap_clr, true)
    local new_cap_alpha = clamp(round(lerp(cap_argb.a, MIN_ALPHA, time_factor)), MIN_ALPHA, MAX_ALPHA)
    -- dbg("all", "cap alpha| old: %s, new: %s", cap_argb.a, new_cap_alpha)
    self.caption:SetTextColor(change_alpha(cap_clr, new_cap_alpha))
    self.active_info["caption_opacity"] = new_cap_alpha

    if new_cap_alpha == MIN_ALPHA and new_bg_alpha == MIN_ALPHA then
        self.active_info["show_time"] = elapsed_time
    end
end

function UICaption:SetCaptionClr()
    -- dbg("all","Setting Caption Colour")
    local cap_argb = get_colourblind_clr(SUBTITLE_CLR, COLOUR_BLIND_TYPE, true)
    if ENABLE_FACTION_CLR then
        -- dbg("dev", "npc faction: %s", self.active_info["npc_faction"])
        cap_argb = get_faction_clr(self.active_info["npc_faction"], COLOUR_BLIND_TYPE, true)
        if not contains(self.active_info, "faction_clr", true) then self.active_info["faction_clr"] = cap_argb end
    end
    cap_argb.a = self.active_info["caption_opacity"]
    -- dbg("all","Caption clr: %s", cap_argb)
    self.caption:SetTextColor(tbl2argb(cap_argb))
    
    local bg_argb = {a=0, r=0, g=0, b=0}
    if ENABLE_BACKGROUND then
        --dbg("dev","using MCM set background")
        bg_argb = get_colourblind_clr(BACKGROUND_CLR, COLOUR_BLIND_TYPE, true)
        bg_argb.a = self.active_info["bg_opacity"]
    end
    -- dbg("all","Bg clr: %s", bg_argb, true)
    self.bg:SetTextureColor(tbl2argb(bg_argb))
end

