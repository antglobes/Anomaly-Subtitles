function UICaption:SetCaptionScale() -- min 3.5m
    local npc = get_unknown_object({id=self.npc_id}, "game")
    local npc_pos = npc:bone_position("bip01_head") or npc:position():add(0, 1.7, 0)
    local actor_pos = db.actor:bone_position("bip01_head") or db.actor:position()
    if
        ( self.last_position and not vec_similar(actor_pos, self.last_position, 1))
        or (self.last_position_npc and not vec_similar(npc:position(), self.last_position_npc, 1)) -- if look_pos is more than 1m from npc look_pos
    then
        local pos = self.caption:GetWndPos()
        local dist = dist_to_pos(db.actor, npc_pos)
        local scale = get_angular_dist(dist) / get_angular_dist(5)
        scale = clamp(scale, 0.45, 0.85)
        -- self.caption:SetWndSize(vector2():set(self.max_cap_w * scale, self.max_cap_h * scale))
        -- self.bg:SetWndSize(vector2():set(self.max_cap_w * scale, self.max_cap_h * scale))
        self.caption:SetWndSize(vector2():set(self.max_cap_w * scale, self.max_cap_h * scale))
        self.bg:SetWndSize(vector2():set(self.max_bg_w, self.max_bg_h * scale))
        self.scale = scale

        local add_y = warfare.lerp(0, CAPTION_HEAR_DIST, scale)
        -- dbg("dev","scale %s, dist: %s", scale, dist)
        self.bg:SetWndPos(vector2():set(pos.x, pos.y - add_y))
        self.caption:SetWndPos(vector2():set(pos.x, pos.y - add_y))
    end
end

function UICaption:Validate(data)
    if not data then
        dbg("debug","no data")
        return false
    end

    if not ENABLE_FIGHT_SUBS and data.xml_id:find("fight") then
        return false
    end


    local npc = get_unknown_object({id=data.npc_id}, "game")
    if not npc then
        -- dbg("dev","no npc")
        return false
    end
    
    if not npc:alive() and not contains(subtitles.recent_npc_deaths, npc:id(), true) then
        -- dbg("dev","object dead")
        return false
    end

    local actor_pos = db.actor:bone_position("bip01_head")
    local npc_pos = npc:bone_position("bip01_head")

    local dist = actor_pos:distance_to(npc_pos)
    if dist > CAPTION_HEAR_DIST then
        -- dbg("dev","object out of range: %s", dist)
        return false
    end

    if not self:ScreenPosValid(game.world2ui(npc_pos, false, true)) then
        dbg("dev", "not valid screen pos")
        return false
    end

    if 
        OBSTRUCT_CHECK 
        and time_global() >= self.active_info["check_material_tmr"] 
    then
        dbg("dev", "running obstruct check")
        local ray = geo_ray({
            ray_range = dist,
            -- visualize = get_config("enable_debug") and get_config("debug_level") > 4,
            flags = 1 + 2 + 4,
        })
        ray.ray:set_ignore_object(db.actor)
        ray.ray:set_ignore_object(npc)

        -- local neck_pos = db.actor:bone_position("bip01_neck")
        local dir_between = vec_sub(npc_pos, actor_pos):normalize()
        local result = ray:get(actor_pos, dir_between).result

        self.last_npc_pos = npc_pos
        self.last_actor_pos = actor_pos
        self.last_material = result.material_name
        self.active_info["check_material_tmr"] = time_global() + 200

        dbg("dev", "hit material: %s", self.last_material)
        dbg("dev", "hit obj: %s", result.object)
        if result.object and IsNpc(result.object) then
            return false
        end
    end

    if 
        self.last_material and
        (
            ( REDUCE_HEAR_DIST and (self.last_material == "materials\\bush" and dist > (CAPTION_HEAR_DIST / 2)))
            or (not EXCLUDE_MATERIALS[self.last_material] and ADD_ALPHA_TYPE ~= ADDITIONAL_ALPHA_TYPES.snd_pen_alpha) -- false will block caption
        )
    then 
        dbg("dev","Ray cast between actor and %s has hit %s", get_npc_name(npc), self.last_material)
        return false
    end

    -- dbg("dev","valid npc")
    return true
end

-- From GhenTuong start
local caption_height = 50

function UICaption:GetScreenPosition()
    local caption_offset = vector():set(0.0, CAPTION_OFFSET,0.0)
    local npc = get_unknown_object({id=self.npc_id}, "game")
    if not npc then
        return 
    end

    local head_pos = npc:bone_position("bip01_head")
	local offset_head_pos = vec_add(head_pos,caption_offset)
    local ui_oh_pos = game.world2ui(offset_head_pos,false,false)

	if (self:ScreenPosValid(ui_oh_pos)) then -- and (vec_hed.y - vec_pos.y < caption_height)) then
        -- local vec = game.world2ui(head_pos, false, false)
        -- if not self:ScreenPosValid(vec) then return end
        return ui_oh_pos
	end
    return game.world2ui(offset_head_pos, false, false)
end

function UICaption:ScreenPosValid(vec)
	return vec and (vec.x ~= -9999) and (vec.y ~= 0) and (vec.x <= 1024) and (vec.y <= 768)
end

function UICaption:ApplyScreenRatio(ele)
	local r = (1024/768)/(device().width/device().height)
	ele:SetWndSize(vector2():set(ele:GetWidth() * r,ele:GetHeight()))
end

function UICaption:CanObstructCheck(npc_pos, actor_pos) -- rework to check when pos changed
    return  
        OBSTRUCT_CHECK 
        and time_global() >= self.active_info["check_material_tmr"]
        and (
            not self.last_npc_pos
            or not self.last_actor_pos
            or not vec_similar(self.last_npc_pos, npc_pos, 1)
            or not vec_similar(self.last_actor_pos, actor_pos, 1)
        )
end

function hud_active()
	if (HUD == nil) then
		HUD = HUDSubtitles()
		get_hud():AddDialogToRender(HUD)
	end
end

function hud_remove()
	if (HUD) then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
end

function hud_update()
	if (HUD) then
		HUD:Update(true)
	end
end

-- From GhenTuong end

class "HUDSubtitles" (CUIScriptWnd)
function HUDSubtitles:__init() super()
    
    dbg("dev","init hud subtitles")
    self.xml = CScriptXmlInit()
    self.xml:ParseFile("ui_marker_hud_subtitles.xml")
    self.ratio = (1024 / 768) / (device().width / device().height)
    self.subtitles = {}
end

function HUDSubtitles:__finalize()
    for id, _ in pairs(self.subtitles) do
        self.subtitles[id] = nil
    end
end

function HUDSubtitles:Update()
    CUIScriptWnd.Update(self)
    local show_caption = main_hud_shown() and ENABLE_SUBS
    local tg = time_global()

    for id, _ in pairs(subtitles.QUEUED_SUBTITLES) do
        if not contains(self.subtitles, id, true) then
            dbg("dev","adding new caption for: %s", id)
            self.subtitles[id] = UICaption(self, id)
        end
    end

    for id, caption in pairs(self.subtitles) do
        if contains(DESPAWNED_NPCS, id, true) then
            dbg("all","removing despawned npc: %s", id)
            self.subtitles[id] = nil
            DESPAWNED_NPCS[id] = nil
        else
            caption:Update(show_caption)
        end
    end
end

function get_angular_dist(dist)
    return 2 * math.atan(1.8 / (2 * dist))
end

-- Callbacks

function on_first_update()
    dbg("dev", "adding hud")
	hud_active()
end

function on_net_destroy()
    dbg("dev","removing hud")
	hud_remove()
end

function on_GUI_show()
    dbg("dev","hide/showing hud")
	hud_update()
end

function collect_despawned_npcs(npc)
    
    dbg("dev","despawning: %s", npc:id())
    local id = npc:id()
    if not contains(DESPAWNED_NPCS, id, true) then
        DESPAWNED_NPCS[id] = true
    end
end 

function on_option_change(options)
    setup_log(options["debug_level"], LOG_HEADER, options["enable_debug"])
    -- FADE_TIME           = options["fade_time"]
    CAPTION_HEAR_DIST          = options["hear_dist"]
    -- MIN_ALPHA = options["min_alpha"]
    -- MAX_ALPHA = options["max_alpha"]
    COLOUR_BLIND_TYPE      = options["colour_blind_type"]
    ENABLE_FACTION_CLR     = options["enable_faction_clr"]
    ENABLE_BACKGROUND      = options["enable_background"]
    BACKGROUND_CLR         = str2argb(options["background_colour"], true)
    SUBTITLE_CLR           = str2argb(options["subtitle_colour"], true)
    SUBTITLE_FONT          = mcm2font(options["subtitle_font"])
    SUBTITLE_ALIGNMENT     = mcm2align(options["subtitle_alignment"])
    CAPTION_OFFSET         = options["caption_offset"]
    SUBTITLE_WND_SIZE      = {w=options["subtitle_width"], h=options["subtitle_height"]}
    ENABLE_SUBS            = options["enable_subs"]
    WORDS_PER_SECOND       = options["words_per_second"]
    ENABLE_FIGHT_SUBS      = options["enable_fight_subs"]
    REDUCE_HEAR_DIST       = options["reduce_hear_dist"]
    OBSTRUCT_CHECK         = options["obstruct_check"]
    EXCLUDE_MATERIALS      = str2tbl(options["exclude_materials"])
    ADD_ALPHA_TYPE        = options["additional_alpha_type"]
    dbg("debug", "Received options: %s", options)

end


function on_game_start()
    RegisterScriptCallback("GUI_on_show",on_GUI_show)
	RegisterScriptCallback("GUI_on_hide",on_GUI_show)
	RegisterScriptCallback("actor_on_first_update",on_first_update)
	RegisterScriptCallback("actor_on_net_destroy",on_net_destroy)
    RegisterScriptCallback("npc_on_net_destroy", collect_despawned_npcs)
    RegisterScriptCallback("as_on_option_change", on_option_change)
end