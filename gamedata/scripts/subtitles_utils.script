-- DEBUGGING
function setup_log(level, header, enabled)
    if not dbg_pr then
        dbg_pr = ag_logging.new({
            level=level,
            header=header,
            enabled=enabled
        })
    else
        dbg_pr:SetLevel(level)
        dbg_pr:Enable(enabled)
    end
end

function dbg(level, fmt, ...)
    if not dbg_pr then
        setup_log(get_config("debug_level"), LOG_HEADER, get_config("enable_debug"))    
    end
    dbg_pr:Log(level, fmt, ...)
end

function in_snd_dir(filename)
    if not filename then return end
    if not filename:find(".ogg$") then filename = filename .. ".ogg" end
    return contains(SND_FILES, filename, true)
    -- return getFS():exist("$game_sounds$", filename)
end

function path_to_xml(path)
    return strformat("as_sub_%s", path:gsub("\\", "_"))
end

function collect_sound_files()
    local tmp = {}
    for idx, folder_name in iterate_folders("$game_sounds$") do
        local files = getFS():file_list_open("$game_sounds$", folder_name, bit_or(FS.FS_ListFiles,FS.FS_RootOnly))
        local file_count = files and files:Size() or 0
        if file_count > 0 then
            for i=0, file_count - 1 do
                local fname = files:GetAt(i)
                local fpath = strformat("%s%s", folder_name, fname)
                -- dbg("dev","Filename: %s", fname)
                -- dbg("dev", "Filepath: %s", fpath)
                tmp[fpath] = true
            end
        end
    end
    SND_FILES = tmp
end

function iterate_folders(root, path)
    path = not path and "" or path
    local folders = collect_folders(root, path)
    local i = 0
    return function()
        i = i + 1
        if folders[i] then
            return i, folders[i]
        end
    end
end

function collect_folders(root, path, tmp)
    path = not path and "" or path
    -- dbg("dev", "collecting folder from: %s", root .. [[\]] .. path)
    tmp = tmp or {}
    local folder_list = getFS():file_list_open(root, path, bit_or(FS.FS_ListFolders, FS.FS_RootOnly))
    -- dbg("dev", "folder list: %s", folder_list ~= nil)
    local folder_list_count = folder_list and folder_list:Size() or 0
    if folder_list_count <= 0 then return tmp end
    -- dbg("dev", "folder count: %s", folder_list_count)
    for i=0, folder_list_count - 1 do
        local folder_name = folder_list:GetAt(i)
        local folder_path = strformat("%s%s", path, folder_name)
        folder_path = folder_path:gsub("^\\", "")
        -- dbg("dev", "folder| name: %s, path: %s", folder_name, folder_path)
        tmp[#tmp + 1] = folder_path
        if getFS():exist(root, folder_path) then 
            collect_folders(root, folder_path, tmp) 
        end
    end
    return tmp
end

function collect_exclude_materials()
    local tmp = {}
    local tmp_order = {}
    local ini_materials = ini_file_ex("materials\\materials.ltx")
    for _, sect in pairs(ini_materials:get_sections()) do
        tmp[sect] = contains(include_materials, sect, true) and include_materials[sect] or false
        tmp_order[#tmp_order + 1] = sect
    end
    for _, sect in pairs(object_materials) do
        tmp[sect] = contains(include_materials, sect, true) and include_materials[sect] or false
        tmp_order[#tmp_order + 1] = sect
    end
    return tmp, invert_table(tmp_order)
end

function get_npc_faction(npc)
    local comm = get_community(npc)
    return not contains(exclude_factions, comm) and comm
end

function on_option_change(options)
    setup_log(options["debug_level"], LOG_HEADER, options["enable_debug"])
    dbg("debug", "Received options")
end

function on_game_start()
    RegisterScriptCallback("on_game_load", collect_sound_files)
    RegisterScriptCallback("as_on_option_change", on_option_change)
end

exclude_factions = {
    "zombied",
    "trader",
    "nil"
}

exclude_materials, exclude_materials_order = collect_exclude_materials()