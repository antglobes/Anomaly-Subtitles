	<!--fight/post_combat_wait-->
	
	<string id="as_sub_characters_voice_human_military_3_fight_post_combat_wait_relax_1">
		<text>Вольно. Разойтись. </text>
	</string>
	<string id="as_sub_characters_voice_human_military_3_fight_post_combat_wait_relax_2">
		<text>Отбой. </text>
	</string>
	<string id="as_sub_characters_voice_human_military_3_fight_post_combat_wait_relax_3">
		<text>Личному составу отдыхать. </text>
	</string>
	<string id="as_sub_characters_voice_human_military_3_fight_post_combat_wait_wait_1">
		<text>Не спать! Осмотреться!</text>
	</string>
	<string id="as_sub_characters_voice_human_military_3_fight_post_combat_wait_wait_2">
